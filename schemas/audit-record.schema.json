{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIDERETH Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "actor_id", "action", "aggregate_type", "aggregate_id", "occurred_at", "correlation_id"],
  "properties": {
    "audit_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "aggregate_type": { "type": "string", "minLength": 1 },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "before_state": { "type": ["string", "null"] },
    "after_state": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": ["string", "null"] },
    "provenance_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "invocation_id": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "authorization_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "action_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "approval_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "tool_id": { "type": ["string", "null"] },
    "tool_version": { "type": ["string", "null"] },
    "capability_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "function_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "provider_id": { "type": ["string", "null"] },
    "implementation_id": { "type": ["string", "null"] },
    "implementation_version": { "type": ["string", "null"] },
    "resource_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "purpose": { "type": ["string", "null"] },
    "jurisdiction_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] },
    "data_class": { "type": ["string", "null"] },
    "requested_scope": { "type": ["string", "null"] },
    "execution_mode": { "type": ["string", "null"] },
    "idempotency_ref": { "type": ["string", "null"] },
    "outcome": { "type": ["string", "null"] },
    "failure": { "type": ["string", "null"] },
    "input_hash": { "type": ["string", "null"] },
    "output_hash": { "type": ["string", "null"] }
  }
}
