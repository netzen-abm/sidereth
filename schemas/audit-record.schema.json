{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIDERETH Audit Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "actor_id", "action", "aggregate_type", "aggregate_id", "occurred_at", "correlation_id"],
  "properties": {
    "audit_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "aggregate_type": { "type": "string", "minLength": 1 },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "before_state": { "type": ["string", "null"] },
    "after_state": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "correlation_id": { "type": "string", "minLength": 1 },
    "causation_id": { "type": ["string", "null"] },
    "provenance_ref": { "anyOf": [{ "$ref": "./resource-ref.schema.json" }, { "type": "null" }] }
  }
}
