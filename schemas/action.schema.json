{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIDERETH Universal Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_id", "schema_version", "kind", "status", "actor_id", "intent", "provenance_ref", "created_at", "updated_at"],
  "properties": {
    "action_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "minimum": 1},
    "kind": {"type": "string", "enum": ["information", "communication", "document_creation", "evidence_operation", "submission", "escalation", "decision", "external_operation", "other"]},
    "status": {"type": "string", "enum": ["proposed", "approved", "rejected", "executing", "completed", "failed", "cancelled"]},
    "actor_id": {"type": "string", "minLength": 1},
    "context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "intent": {"type": "string", "minLength": 1},
    "authorization_ref": {"type": ["string", "null"]},
    "precondition_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requires_explicit_approval": {"type": "boolean"},
    "provenance_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
